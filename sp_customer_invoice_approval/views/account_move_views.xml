<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_sp_approval" model="ir.ui.view">
        <field name="name">account.move.form.inherit.sp.approval</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <xpath expr="//button[@name='action_post']" position="before">
                <field name="sp_approval_required" invisible="1"/>
                <field name="sp_is_approver" invisible="1"/>
                <button name="action_sp_send_for_approval" type="object"
                        string="Send for Approval" class="oe_highlight"
                        data-hotkey="z"
                        invisible="not sp_approval_required or state != 'draft' or sp_approval_state != 'draft'"/>
                <button name="action_sp_approve" type="object"
                        string="Approve" class="oe_highlight"
                        invisible="sp_approval_state != 'waiting' or not sp_is_approver"/>
                <button name="action_sp_open_reject_wizard" type="object"
                        string="Reject"
                        invisible="sp_approval_state != 'waiting' or not sp_is_approver"/>
                <button name="action_sp_reset_approval" type="object"
                        string="Reset Approval"
                        invisible="sp_approval_state != 'rejected' or not sp_is_approver"/>
                <field name="sp_approval_state" widget="statusbar"
                       statusbar_visible="draft,waiting,approved"
                       invisible="not sp_approval_required"/>
            </xpath>

            <xpath expr="//div[hasclass('oe_title')]" position="before">
                <div class="alert alert-danger" role="alert" invisible="sp_approval_state != 'rejected'">
                    <strong>Rejected</strong>
                    by <field name="sp_rejected_by" readonly="1" class="oe_inline"/>:
                    <field name="sp_rejection_reason" readonly="1" class="oe_inline"/>
                </div>
            </xpath>

        </field>
    </record>

</odoo>
