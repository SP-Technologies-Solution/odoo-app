<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_sp_stock" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.sp.pos.stock</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='margin_and_cost']" position="after">
                <setting id="sp_pos_stock_display" string="Show stock on products"
                         help="Show the available quantity on each product of the POS grid">
                    <field name="pos_sp_display_stock"/>
                    <div class="content-group mt16" invisible="not pos_sp_display_stock">
                        <label for="pos_sp_stock_display_type" class="o_light_label"/>
                        <field name="pos_sp_stock_display_type"/>
                    </div>
                </setting>
                <setting id="sp_pos_stock_restriction" string="Out-of-stock products"
                         help="What to do when a storable product runs out of stock">
                    <field name="pos_sp_out_of_stock_mode"/>
                </setting>
            </xpath>
        </field>
    </record>

</odoo>
