<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_form_view_sp_price_history" model="ir.ui.view">
        <field name="name">product.template.form.inherit.sp.price.history</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">

            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_sp_open_price_history" type="object"
                        class="oe_stat_button" icon="fa-line-chart"
                        groups="sp_sale_price_history.group_price_history_user">
                    <field name="sp_price_history_count" widget="statinfo"
                           string="Price Changes"/>
                </button>
            </xpath>

            <xpath expr="//field[@name='list_price']" position="after">
                <field name="sp_previous_price" widget="monetary"
                       options="{'currency_field': 'currency_id'}"
                       groups="sp_sale_price_history.group_price_history_user"
                       invisible="not sp_last_price_change"/>
                <field name="sp_last_price_change"
                       groups="sp_sale_price_history.group_price_history_user"
                       invisible="not sp_last_price_change"/>
            </xpath>

        </field>
    </record>

</odoo>
