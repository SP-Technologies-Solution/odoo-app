<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="sp_pos_merge_table_orders.FloorScreen"
       t-inherit="pos_restaurant.FloorScreen" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('order-count')]" position="before">
            <div t-if="pos.spTableIsMergeable(table)"
                 class="sp-merge-badge d-flex align-items-center justify-content-center position-absolute top-0 start-0 rounded-3 z-2 badge text-bg-primary"
                 title="This table has an order that can be merged">
                <i class="fa fa-compress" role="img" aria-label="Mergeable order"/>
            </div>
        </xpath>
    </t>
</templates>
