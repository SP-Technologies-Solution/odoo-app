<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_sp_merge_orders" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.sp.merge.orders</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='margin_and_cost']" position="after">
                <setting id="sp_pos_merge_orders" string="Merge Table Orders"
                         help="Combine open table orders on the same floor into one order from the POS screen">
                    <field name="pos_sp_merge_orders_enabled"/>
                </setting>
            </xpath>
        </field>
    </record>

</odoo>
