<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wa_template_builder_form" model="ir.ui.view">
        <field name="name">wa.template.builder.form</field>
        <field name="model">wa.template.builder</field>
        <field name="arch" type="xml">
            <form string="Create Document Template">
                <div class="alert alert-info" role="alert">
                    This creates a template with a <strong>document header</strong>, which is
                    what lets Odoo send a PDF to anyone at any time — no inbound message
                    needed. Meta reviews it, usually within the hour.
                </div>
                <group>
                    <group>
                        <field name="account_id"/>
                        <field name="name"/>
                        <field name="language_code"/>
                        <field name="category"/>
                    </group>
                    <group>
                        <field name="footer_text"/>
                        <field name="add_link_button"/>
                        <field name="button_text" invisible="not add_link_button"
                               required="add_link_button"/>
                        <field name="button_url_base" invisible="not add_link_button"
                               required="add_link_button"/>
                    </group>
                </group>
                <group string="Message Body">
                    <div colspan="2" class="text-muted mb-2">
                        Write the message text. Use <code>{{1}}</code>, <code>{{2}}</code> …
                        for the values Odoo fills in at send time. The message may not
                        begin or end with a variable.
                    </div>
                    <field name="body_text" nolabel="1" colspan="2"
                           placeholder="Hi {{1}}, your receipt {{2}} is attached.&#10;&#10;Thank you for visiting!"/>
                </group>
                <group string="Sample Values (for Meta review)">
                    <div colspan="2" class="text-muted mb-2">
                        A comma-separated example for each variable, in order
                        (<code>{{1}}, {{2}} …</code>). Meta shows these to its reviewers.
                    </div>
                    <field name="sample_values" nolabel="1" colspan="2"
                           placeholder="Customer, POS/0001"/>
                </group>
                <footer>
                    <button name="action_create_template" type="object"
                            string="Submit to Meta" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_wa_template_builder" model="ir.actions.act_window">
        <field name="name">Create Document Template</field>
        <field name="res_model">wa.template.builder</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
