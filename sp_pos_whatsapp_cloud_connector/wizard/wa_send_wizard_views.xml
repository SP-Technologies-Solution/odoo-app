<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wa_send_wizard_form" model="ir.ui.view">
        <field name="name">wa.send.wizard.form</field>
        <field name="model">wa.send.wizard</field>
        <field name="arch" type="xml">
            <form string="Send on WhatsApp">
                <group>
                    <group>
                        <field name="document_name"/>
                        <field name="partner_id"/>
                        <field name="phone" placeholder="919876543210"/>
                    </group>
                    <group>
                        <field name="account_id"/>
                        <field name="send_mode" widget="radio"/>
                        <field name="model" invisible="1"/>
                        <field name="res_id" invisible="1"/>
                    </group>
                </group>

                <group string="Delivery">
                    <field name="use_template"/>
                    <div class="text-muted" colspan="2" invisible="use_template">
                        Free-form messages only reach contacts who messaged you within
                        the last 24 hours. Outside that window WhatsApp rejects them
                        with error 131047.
                    </div>
                    <field name="template_id" invisible="not use_template"
                           required="use_template"/>
                    <field name="template_link_mode" invisible="1"/>
                    <field name="body_param_count" invisible="1"/>
                </group>

                <group string="Template Variables" invisible="not use_template or body_param_count == 0">
                    <field name="template_body" readonly="1" nolabel="1" colspan="2"/>
                    <field name="param_1" invisible="body_param_count &lt; 1"/>
                    <field name="param_2" invisible="body_param_count &lt; 2"/>
                    <field name="param_3" invisible="body_param_count &lt; 3"/>
                    <field name="param_4" invisible="body_param_count &lt; 4"/>
                    <field name="param_5" invisible="body_param_count &lt; 5"/>
                </group>

                <group string="Message" invisible="use_template">
                    <field name="caption" nolabel="1"
                           placeholder="e.g. Thanks for visiting! Please rate us: https://g.page/..."/>
                </group>

                <footer>
                    <button name="action_send" type="object" string="Send"
                            class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"
                            data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
