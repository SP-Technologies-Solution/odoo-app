<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="module_category_whatsapp" model="ir.module.category">
            <field name="name">WhatsApp</field>
            <field name="sequence">45</field>
        </record>

        <record id="group_wa_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_category_whatsapp"/>
            <field name="comment">Can send documents on WhatsApp and see the message log.</field>
        </record>

        <record id="group_wa_manager" model="res.groups">
            <field name="name">Administrator</field>
            <field name="category_id" ref="module_category_whatsapp"/>
            <field name="implied_ids" eval="[(4, ref('group_wa_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
            <field name="comment">Can configure accounts, credentials and templates.</field>
        </record>

        <!-- Messages are company data; keep multi-company installs separated. -->
        <record id="wa_message_company_rule" model="ir.rule">
            <field name="name">WhatsApp Message: multi-company</field>
            <field name="model_id" ref="model_wa_message"/>
            <field name="global" eval="True"/>
            <field name="domain_force">
                ['|', ('account_id.company_id', '=', False),
                      ('account_id.company_id', 'in', company_ids)]
            </field>
        </record>

        <record id="wa_account_company_rule" model="ir.rule">
            <field name="name">WhatsApp Account: multi-company</field>
            <field name="model_id" ref="model_wa_account"/>
            <field name="global" eval="True"/>
            <field name="domain_force">
                ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
            </field>
        </record>
    </data>
</odoo>
