<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_pos_receipt_document">
        <t t-call="web.external_layout">
            <div class="page">
                <h2>
                    Receipt
                    <span t-field="doc.pos_reference"/>
                </h2>

                <div class="row mb-4">
                    <div class="col-6">
                        <strong>Date:</strong>
                        <span t-field="doc.date_order" t-options='{"widget": "datetime"}'/>
                        <br/>
                        <strong>Point of Sale:</strong>
                        <span t-field="doc.config_id.name"/>
                    </div>
                    <div class="col-6" t-if="doc.partner_id">
                        <strong>Customer:</strong>
                        <br/>
                        <span t-field="doc.partner_id"
                              t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": true}'/>
                    </div>
                </div>

                <table class="table table-sm o_main_table">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th class="text-end">Qty</th>
                            <th class="text-end">Unit Price</th>
                            <th class="text-end">Disc.%</th>
                            <th class="text-end">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="doc.lines" t-as="line">
                            <td>
                                <span t-field="line.product_id"/>
                                <t t-if="line.attribute_value_ids">
                                    <br/>
                                    <small t-esc="', '.join(line.attribute_value_ids.mapped('name'))"/>
                                </t>
                            </td>
                            <td class="text-end">
                                <span t-field="line.qty"/>
                            </td>
                            <td class="text-end">
                                <span t-field="line.price_unit"
                                      t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                            </td>
                            <td class="text-end">
                                <span t-field="line.discount"/>
                            </td>
                            <td class="text-end">
                                <span t-field="line.price_subtotal_incl"
                                      t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                            </td>
                        </tr>
                    </tbody>
                </table>

                <div class="clearfix">
                    <div id="total" class="row justify-content-end">
                        <div class="col-5">
                            <table class="table table-sm">
                                <tr>
                                    <td>Taxes</td>
                                    <td class="text-end">
                                        <span t-field="doc.amount_tax"
                                              t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                    </td>
                                </tr>
                                <tr class="border-black o_total">
                                    <td><strong>Total</strong></td>
                                    <td class="text-end">
                                        <strong t-field="doc.amount_total"
                                                t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>

                <div t-if="doc.payment_ids" class="mt-3">
                    <strong>Payments</strong>
                    <table class="table table-sm">
                        <tr t-foreach="doc.payment_ids" t-as="payment">
                            <td><span t-field="payment.payment_method_id.name"/></td>
                            <td class="text-end">
                                <span t-field="payment.amount"
                                      t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
        </t>
    </template>

    <template id="report_pos_receipt">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="sp_pos_whatsapp_cloud_connector.report_pos_receipt_document"
                   t-lang="doc.partner_id.lang or user.lang"/>
            </t>
        </t>
    </template>
</odoo>
