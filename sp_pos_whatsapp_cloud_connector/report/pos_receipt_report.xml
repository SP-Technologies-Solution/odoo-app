<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Odoo 18 core has no PDF report for a single pos.order: the customer
        receipt is rendered client side as a JPEG and only report_userlabel and
        report_saledetails exist server side. This gives POS the same
        render-to-PDF path used to attach the receipt to a WhatsApp message.
    -->
    <record id="action_report_pos_receipt" model="ir.actions.report">
        <field name="name">POS Receipt</field>
        <field name="model">pos.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sp_pos_whatsapp_cloud_connector.report_pos_receipt</field>
        <field name="report_file">sp_pos_whatsapp_cloud_connector.report_pos_receipt</field>
        <field name="print_report_name">'Receipt - %s' % (object.pos_reference or object.name)</field>
        <field name="binding_model_id" ref="point_of_sale.model_pos_order"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
