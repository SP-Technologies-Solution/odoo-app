<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_wa" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.pos.whatsapp</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_payment_section']" position="after">
                <block title="WhatsApp" id="pos_whatsapp_section">
                    <setting string="Send receipts on WhatsApp"
                             help="Adds a 'Send on WhatsApp' button to the payment screen so the receipt can be sent to the customer.">
                        <field name="pos_wa_account_id"/>
                        <div class="content-group mt-2" invisible="not pos_wa_account_id">
                            <label for="pos_wa_template_id" class="o_light_label"/>
                            <field name="pos_wa_template_id"
                                   domain="[('account_id', '=', pos_wa_account_id), ('status', '=', 'APPROVED')]"/>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
