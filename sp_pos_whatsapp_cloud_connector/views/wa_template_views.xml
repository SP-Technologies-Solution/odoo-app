<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wa_template_list" model="ir.ui.view">
        <field name="name">wa.template.list</field>
        <field name="model">wa.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="language_code"/>
                <field name="category"/>
                <field name="header_format"/>
                <field name="link_mode"/>
                <field name="body_param_count" string="Variables"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'APPROVED'"
                       decoration-danger="status in ('REJECTED', 'DISABLED')"
                       decoration-warning="status in ('PENDING', 'PAUSED')"/>
                <field name="account_id"/>
            </list>
        </field>
    </record>

    <record id="view_wa_template_form" model="ir.ui.view">
        <field name="name">wa.template.form</field>
        <field name="model">wa.template</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_sync_from_meta" type="object"
                            string="Sync from Meta" class="btn-primary"/>
                    <field name="status" widget="statusbar"
                           statusbar_visible="PENDING,APPROVED"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="account_id"/>
                            <field name="language_code"/>
                            <field name="category"/>
                            <field name="header_format"/>
                        </group>
                        <group string="Portal Link">
                            <field name="link_mode"/>
                            <field name="button_url_base"
                                   invisible="link_mode != 'button'"/>
                            <field name="link_param_index"
                                   invisible="link_mode != 'body'"/>
                        </group>
                    </group>
                    <group string="Approved Body">
                        <field name="body_text" nolabel="1" readonly="1"/>
                        <field name="body_param_count"/>
                    </group>
                    <div class="alert alert-info" role="alert"
                         invisible="header_format == 'DOCUMENT'">
                        This template has no document header, so it cannot carry a PDF.
                        Use it for portal links only.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_wa_template" model="ir.actions.act_window">
        <field name="name">WhatsApp Templates</field>
        <field name="res_model">wa.template</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No templates yet</p>
            <p>
                Create templates in Meta Business Manager, then press
                <b>Sync Templates</b> on the account to pull them in. Only approved
                templates can be sent.
            </p>
        </field>
    </record>
</odoo>
